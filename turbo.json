{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env*", "apps/**/.env*"],
  "globalEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET"],
  "tasks": {
    "dev": {
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_*"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "apps/**/.env*"]
    },
    "build": {
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_*"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "apps/**/.env*"]
    },
    "start": {
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_*"
      ]
    }
  }
}
